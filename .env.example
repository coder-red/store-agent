# --- Mode ---
DEMO_MODE=true
# --- Storefront platform (the plug) ---
# mock     = built-in demo store, no platform needed
# shopify  = built-in reference adapter (uses the SHOPIFY_* vars below)
# or point at any adapter implementing app.commerce.base.CommerceProvider:
# PLATFORM=your_pkg.adapters:WooCommerceAdapter
PLATFORM=mock

# --- OpenRouter (Free LLM) ---
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_PROVIDER=openrouter
LLM_MODEL=openrouter/free

# --- OR use OpenAI directly ---
# OPENAI_API_KEY=your_openai_key
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o

# --- Shopify (reference adapter; needed when PLATFORM=shopify) ---
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_API_KEY=your_api_key
SHOPIFY_API_SECRET=your_api_secret

# --- Persistence ---
# Default is SQLite (zero setup, just a file in data/). Set to "json" to
# use JSON files instead, or set SUPABASE_URL + SUPABASE_KEY to persist in
# the cloud via Supabase Postgres.
DB_BACKEND=sqlite

# --- Optional cloud persistence (Supabase) ---
# Only needed if you want conversations/escalations in the cloud instead of
# the local SQLite file.
SUPABASE_URL=
SUPABASE_KEY=

# --- Channel (webchat | whatsapp | telegram | email) ---
CHANNEL=webchat

# --- WhatsApp (Twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
OWNER_WHATSAPP_NUMBER=whatsapp:+your_number

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
OWNER_TELEGRAM_CHAT_ID=

# --- Email (Resend) ---
RESEND_API_KEY=
SUPPORT_EMAIL=support@yourstore.com
OWNER_EMAIL=founder@yourstore.com

# --- Store Config ---
STORE_NAME=Northlane
RETURN_WINDOW_DAYS=30
INVENTORY_THRESHOLD=5
