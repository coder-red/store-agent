{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://store-agent-app.onrender.com/api/$1"
    },
    {
      "source": "/webhook/(.*)",
      "destination": "https://store-agent-app.onrender.com/webhook/$1"
    },
    {
      "source": "/store/(.*)",
      "destination": "https://store-agent-app.onrender.com/store/$1"
    },
    {
      "source": "/store.html",
      "destination": "https://store-agent-app.onrender.com/store.html"
    },
    {
      "source": "/favicon.svg",
      "destination": "https://store-agent-app.onrender.com/favicon.svg"
    },
    {
      "source": "/health",
      "destination": "https://store-agent-app.onrender.com/health"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
